rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isActiveUser() {
      return isAuthenticated() && getUserData().status == 'active';
    }

    // ─── Users Collection ─────────────────────────────────────────────────────
    match /users/{uid} {
      // User can read their own profile; admin can read all
      allow read: if isOwner(uid) || isAdmin();

      // User can create their own profile on signup
      allow create: if isOwner(uid) && isAuthenticated();

      // User can update only safe fields (including their own API keys); admin can update everything
      allow update: if (isOwner(uid) && isAuthenticated() &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'status', 'credits', 'plan', 'approvedAt', 'approvedBy']))
                    || isAdmin();

      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }

    // ─── Generations Collection ───────────────────────────────────────────────
    match /generations/{genId} {
      // Active user can read their own generations; admin can read all
      allow read: if (isActiveUser() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      // Active user can create generations for themselves
      allow create: if isActiveUser()
                    && request.resource.data.userId == request.auth.uid;

      // Active user can update (favorite toggle) or delete their own generations
      allow update: if (isActiveUser() && resource.data.userId == request.auth.uid)
                    || isAdmin();

      allow delete: if (isActiveUser() && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ─── Credits / Transactions ────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                  || isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── App Settings ────────────────────────────────────────────────────────
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Admin-only collections ────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /logs/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Story Video Projects ─────────────────────────────────────────────────
    match /story_projects/{projectId} {
      // Active user can read their own projects; admin can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      // Active user can create/update their own projects
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || isAdmin();

      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}